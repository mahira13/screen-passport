NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Contact for the Nominatim User-Agent (your email or project URL)
GEOCODER_CONTACT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ADMIN_PASSWORD=
# Long random string; salts the IP hashes used for rate limits and reports
RATE_LIMIT_SALT=
NEXT_PUBLIC_SITE_URL=

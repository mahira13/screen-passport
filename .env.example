# Copy to .env.local and fill in. Never put real values in this file: it is committed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Contact for the Nominatim User-Agent (your email or project URL)
GEOCODER_CONTACT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ADMIN_PASSWORD=
# Optional long random string; salts the IP hashes for rate limits and reports (defaults to one derived from the service role key)
RATE_LIMIT_SALT=
# "off" skips the per-IP limits (trips, joins, reports) while testing. Leave empty in production.
RATE_LIMITS=
NEXT_PUBLIC_SITE_URL=

# TMDB metadata (npm run tmdb): year and alternative titles only. One of these, from themoviedb.org/settings/api
TMDB_READ_TOKEN=
# TMDB_API_KEY=
# Optional contact for the Wikidata User-Agent (npm run wikidata)
# WIKIDATA_CONTACT=
